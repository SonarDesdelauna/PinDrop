    "NSCameraUsageDescription" : {
      "comment" : "Info.plist: NSCameraUsageDescription",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PinDrop uses the camera to capture live moments you choose to drop on the map. Photos from your library are never used."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PinDrop usa la fotocamera per scattare i momenti live che scegli di pubblicare sulla mappa. Le foto della tua libreria non vengono mai usate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PinDrop usa la cámara para capturar los momentos en vivo que eliges publicar en el mapa. Nunca se usan las fotos de tu fototeca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PinDrop utilise l'appareil photo pour capturer les moments en direct que tu choisis de publier sur la carte. Les photos de ta photothèque ne sont jamais utilisées."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PinDrop verwendet die Kamera, um Live-Momente aufzunehmen, die du auf der Karte teilen möchtest. Fotos aus deiner Mediathek werden nie verwendet."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Info.plist: NSLocationWhenInUseUsageDescription",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PinDrop uses your location only while the app is open: to pin your photos, show you on the map with how long you've been there, and count visits to your saved places. There is no background tracking."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PinDrop usa la tua posizione solo mentre l'app è aperta: per fissare le tue foto, mostrarti sulla mappa con da quanto tempo sei lì e contare le visite ai tuoi posti salvati. Nessun tracciamento in background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PinDrop usa tu ubicación solo mientras la app está abierta: para fijar tus fotos, mostrarte en el mapa con cuánto tiempo llevas ahí y contar las visitas a tus lugares guardados. No hay rastreo en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PinDrop utilise ta position uniquement quand l'app est ouverte : pour épingler tes photos, te montrer sur la carte avec depuis combien de temps tu es là et compter tes visites à tes lieux enregistrés. Aucun suivi en arrière-plan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PinDrop nutzt deinen Standort nur, während die App geöffnet ist: um deine Fotos zu pinnen, dich auf der Karte mit deiner Aufenthaltsdauer zu zeigen und Besuche deiner gespeicherten Orte zu zählen. Es gibt kein Tracking im Hintergrund."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
