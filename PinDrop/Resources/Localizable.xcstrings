    "locationReminder.explain" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These friends can't be seen on the map when PinDrop is closed. Send them a message to switch their location to “Always”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi amici non si vedono sulla mappa quando PinDrop è chiusa. Mandagli un messaggio per mettere la posizione su “Sempre”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos amigos no se ven en el mapa cuando PinDrop está cerrada. Envíales un mensaje para poner la ubicación en “Siempre”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces amis ne sont pas visibles sur la carte quand PinDrop est fermé. Envoie-leur un message pour passer à « Toujours »."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Freunde sind bei geschlossenem PinDrop nicht auf der Karte. Schick ihnen eine Nachricht, damit sie „Immer“ einstellen."
          }
        }
      }
    },
