            "value" : "Teile den Moment"
          }
        }
      }
    },
    "onboarding.step2.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Friends' pins stay frosted until you drop your own. Every pin fades away after 6 hours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pin degli amici restano sfocati finché non pubblichi il tuo. Ogni pin svanisce dopo 6 ore."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pines de tus amigos siguen difuminados hasta que publiques el tuyo. Cada pin desaparece a las 6 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pins de tes amis restent floutés tant que tu n'as pas publié le tien. Chaque pin disparaît après 6 heures."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pins deiner Freunde bleiben verschwommen, bis du deinen eigenen teilst. Jeder Pin verschwindet nach 6 Stunden."
          }
        }
      }
    },
    "onboarding.step2.title" : {
      "extractionState" : "manual",
      "localizations" : {
