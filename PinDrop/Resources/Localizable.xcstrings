    "onboarding.step3.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PinDrop reads your location only when you take a photo. No background tracking, no forced notifications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PinDrop legge la tua posizione solo quando scatti una foto. Nessun tracciamento in background, nessuna notifica forzata."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PinDrop solo lee tu ubicación cuando tomas una foto. Sin rastreo en segundo plano ni notificaciones forzadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PinDrop ne lit ta position que lorsque tu prends une photo. Aucun suivi en arrière-plan, aucune notification forcée."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PinDrop liest deinen Standort nur, wenn du ein Foto machst. Kein Hintergrund-Tracking, keine erzwungenen Mitteilungen."
          }
        }
      }
    },
