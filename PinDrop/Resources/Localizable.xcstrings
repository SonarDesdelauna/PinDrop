    "locationReminder.sms %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hey %@! On PinDrop set your location to “Always” (Settings › PinDrop › Location) so we can see each other on the map even when the app is closed 📍"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ehi %@! Su PinDrop metti la posizione su “Sempre” (Impostazioni › PinDrop › Posizione) così ci vediamo sulla mappa anche ad app chiusa 📍"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Hola %@! En PinDrop pon la ubicación en “Siempre” (Ajustes › PinDrop › Ubicación) para vernos en el mapa aunque la app esté cerrada 📍"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salut %@ ! Sur PinDrop, mets la position sur « Toujours » (Réglages › PinDrop › Position) pour qu'on se voie sur la carte même app fermée 📍"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hey %@! Stell bei PinDrop den Standort auf „Immer“ (Einstellungen › PinDrop › Standort), damit wir uns auch bei geschlossener App auf der Karte sehen 📍"
          }
        }
      }
    },
