    "camera.video.holdHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slide up to lock · you can flip the camera while recording"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri verso l'alto per bloccare · puoi girare la fotocamera mentre registri"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia arriba para bloquear · puedes girar la cámara mientras grabas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glisse vers le haut pour verrouiller · tu peux changer de caméra pendant l'enregistrement"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach oben wischen zum Sperren · du kannst beim Filmen die Kamera wechseln"
          }
        }
      }
    },
    "camera.video.lockedHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locked · tap the shutter to stop, flip to film the other side"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloccato · tocca lo scatto per fermare, gira la fotocamera per riprendere l'altro lato"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueado · toca el disparador para parar, gira la cámara para grabar el otro lado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrouillé · touche le déclencheur pour arrêter, change de caméra pour filmer l'autre côté"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesperrt · Auslöser tippen zum Stoppen, Kamera wechseln für die andere Seite"
          }
        }
      }
    }
