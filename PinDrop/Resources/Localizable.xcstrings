    "post.capsule.note %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The capsule stays here for 24 hours. Friends see the crystal and your hint on the map, but it opens only when they're within %@ of this exact spot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capsula resta qui per 24 ore. Gli amici vedono il cristallo e l'indizio sulla mappa, ma si apre solo quando sono a meno di %@ da questo punto esatto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cápsula se queda aquí 24 horas. Tus amigos ven el cristal y la pista en el mapa, pero solo se abre a menos de %@ de este punto exacto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capsule reste ici 24 heures. Tes amis voient le cristal et l'indice sur la carte, mais elle ne s'ouvre qu'à moins de %@ de cet endroit précis."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kapsel bleibt 24 Stunden hier. Freunde sehen Kristall und Hinweis auf der Karte, aber sie öffnet sich erst in weniger als %@ Entfernung von genau diesem Ort."
          }
        }
      }
    },
