    "locationBanner.always.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location is set to “While Using”: when PinDrop is closed your friends no longer see where you are. Switch to “Always”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La posizione è su “Mentre usi l'app”: quando PinDrop è chiusa i tuoi amici non vedono più dove sei. Passa a “Sempre”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación está en “Al usar la app”: cuando PinDrop está cerrada tus amigos no ven dónde estás. Cambia a “Siempre”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La position est sur « Lorsque l'app est active » : quand PinDrop est fermé, tes amis ne voient plus où tu es. Passe à « Toujours »."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standort steht auf „Beim Verwenden“: Ist PinDrop geschlossen, sehen deine Freunde nicht mehr, wo du bist. Wechsle zu „Immer“."
          }
        }
      }
    },
