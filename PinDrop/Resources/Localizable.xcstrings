      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snap a live POV and pin it to your friends' map. No camera roll, no filters, no AI — just the moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scatta un POV live e fissalo sulla mappa dei tuoi amici. Niente galleria, filtri o AI: solo il momento."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toma un POV en vivo y fíjalo en el mapa de tus amigos. Sin galería, sin filtros, sin IA: solo el momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prends un POV en direct et épingle-le sur la carte de tes amis. Pas de pellicule, pas de filtres, pas d'IA : juste l'instant."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm einen Live-POV auf und pinne ihn auf die Karte deiner Freunde. Keine Mediathek, keine Filter, keine KI – nur der Moment."
          }
        }
      }
    },
    "onboarding.step1.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drop the moment"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fissa il momento"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte el momento"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épingle l'instant"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile den Moment"
          }
        }
      }
    },
    "onboarding.step2.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Friends' pins stay frosted until you drop your own. Every pin fades away after 6 hours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pin degli amici restano sfocati finché non pubblichi il tuo. Ogni pin svanisce dopo 6 ore."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pines de tus amigos siguen difuminados hasta que publiques el tuyo. Cada pin desaparece a las 6 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pins de tes amis restent floutés tant que tu n'as pas publié le tien. Chaque pin disparaît après 6 heures."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pins deiner Freunde bleiben verschwommen, bis du deinen eigenen teilst. Jeder Pin verschwindet nach 6 Stunden."
          }
        }
      }
    },
    "onboarding.step2.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give to get"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dai per ricevere"
          }
        },
        "es" : {
