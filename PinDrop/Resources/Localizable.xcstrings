      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap for a photo or hold for a video, then add effects, text and stickers if you like."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca per una foto o tieni premuto per un video, poi se vuoi aggiungi effetti, testo e sticker."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
